#!/bin/bash
# 数字工坊.app — 打开本地工作台网页
set -euo pipefail

CANDIDATES=(
  "$HOME/数字工坊/app/index.html"
  "$HOME/digital-workshop/app/index.html"
)
APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
REPO_GUESS="$(cd "$APP_BUNDLE/../.." && pwd)"
CANDIDATES+=("$REPO_GUESS/app/index.html")
CANDIDATES+=("$(cd "$APP_BUNDLE/.." && pwd)/app/index.html")

TARGET=""
for f in "${CANDIDATES[@]}"; do
  if [[ -f "$f" ]]; then TARGET="$f"; break; fi
done

if [[ -z "$TARGET" ]]; then
  osascript -e 'display alert "找不到工作台" message "请先把仓库 clone 到 ~/数字工坊，或把本 App 放在仓库的 mac-app 目录内。" as critical' 2>/dev/null || \
    echo "找不到 app/index.html。请 clone 到 ~/数字工坊。" >&2
  exit 1
fi

ABS="$(cd "$(dirname "$TARGET")" && pwd)/$(basename "$TARGET")"

if [[ "${1:-}" == "--app" ]] || [[ "${DIGITAL_WORKSHOP_CHROME_APP:-}" == "1" ]]; then
  if [[ -d "/Applications/Google Chrome.app" ]]; then
    open -na "Google Chrome" --args --app="file://$ABS"
    exit 0
  fi
fi
open "$ABS"
